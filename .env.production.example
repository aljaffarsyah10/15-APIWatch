# ==============================================================================
# APIWatch Production Environment Variables Template
# Copy this file to .env.production on your production server.
# NEVER commit .env.production containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & Routing
# ------------------------------------------------------------------------------
# Your public fully qualified domain name (e.g. apiwatch.yourcompany.com)
APP_DOMAIN=apiwatch.example.com

# ACME Email for automatic Let's Encrypt TLS certificate issuance & renewal
ACME_EMAIL=admin@example.com

# Public web application base URL
NEXT_PUBLIC_APP_URL=https://apiwatch.example.com

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=apiwatch
# Generate a strong password: openssl rand -base64 24
POSTGRES_PASSWORD=change_this_to_a_strong_database_password
POSTGRES_DB=apiwatch

# Web & Worker internal connection string
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------------------------
# 3. Cache & Queue (Redis 7)
# ------------------------------------------------------------------------------
# Generate a strong Redis auth token: openssl rand -base64 24
REDIS_PASSWORD=change_this_to_a_strong_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ------------------------------------------------------------------------------
# 4. Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=https://apiwatch.example.com

# ------------------------------------------------------------------------------
# 5. Application Security & Encryption
# ------------------------------------------------------------------------------
# Must be exactly 32 bytes (64 hex characters) for AES-256-GCM header encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=generate_with_openssl_rand_hex_32_must_be_64_hex_chars

# ------------------------------------------------------------------------------
# 6. Email Alerts (SMTP Provider: Resend / SendGrid / Postmark / SES / Mailgun)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key_or_password
SMTP_FROM=alerts@apiwatch.example.com

# ------------------------------------------------------------------------------
# 7. Engine & Worker Performance
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=10
SCHEDULER_INTERVAL_MS=10000
MONITOR_DEFAULT_TIMEOUT_MS=10000
MONITOR_MAX_RESPONSE_BYTES=1048576
MONITOR_DEFAULT_RETENTION_DAYS=30
